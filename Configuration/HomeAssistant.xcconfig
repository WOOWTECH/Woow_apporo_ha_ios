#include "Brand.xcconfig"
VERSIONING_SYSTEM = apple-generic
#include "Version.xcconfig"

// Signing team. The real value lives in the git-ignored HomeAssistant.overrides.xcconfig
// (currently W4UWZ8NP2P) and is included below. Deliberately left EMPTY here instead of
// carrying upstream's QMQYCKL255 fallback: that is Home Assistant's own team, it can never
// sign com.apporo.*, and having it as a fallback made a missing overrides file look like a
// working configuration. Empty means device builds fail loudly with "no team selected".
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = com.apporo

// Suffix appended to BRAND_URL_SCHEME to build the app's custom URL scheme.
// Empty for Release; HomeAssistant.debug.xcconfig sets it to "-dev" so a dev build and a
// production build installed on the same device cannot steal each other's deep links.
BRAND_URL_SCHEME_SUFFIX =

// --- Special entitlements ----------------------------------------------------------------
// Consumed at build time by Configuration/Entitlements/activate_special_entitlements.sh,
// which adds the entitlement only when the value is exactly 1.
//
// Upstream wrote these as $(ENABLE_X_$(DEVELOPMENT_TEAM)) and only ever defined the
// _QMQYCKL255 variants. Our team is W4UWZ8NP2P, so every one of them expanded to an empty
// string and all of those entitlements were SILENTLY disabled. Values are now explicit, so "off"
// is a recorded decision rather than an accident.
//
// Set these BEFORE the overrides include so a local overrides file can still flip one.
ENABLE_PUSH_PROVIDER = 0
// ^ Apporo aiot 1.0 excludes iOS Local Push (the PushProvider network extension).
ENABLE_CARPLAY = 0
// ^ Apporo aiot 1.0 excludes CarPlay (both carplay-driving-task and
//   carplay-voice-based-conversation come from this one flag).
//
// ENABLE_THREAD_NETWORK_CREDENTIALS used to sit here. Owner decision 2026-09-14: Matter /
// Thread is removed from the product entirely — the Extensions-Matter target, the Thread
// credential UI and the MatterSupport / ThreadNetwork framework links are all gone — so there
// is no flag left to switch and activate_special_entitlements.sh no longer reads one.

// UNDECIDED — parked at 0 on purpose, see the report / IMPL-SPEC §2.5 B-3.
// Critical alerts require a separate entitlement that Apple must grant to team W4UWZ8NP2P
// (https://developer.apple.com/contact/request/notifications-critical-alerts). Setting this
// to 1 before that grant exists makes signing/upload fail, so it must stay 0 until Apple
// approves. Consequence of 0: notifications cannot bypass Do Not Disturb / silent mode.
ENABLE_CRITICAL_ALERTS = 0

// UNDECIDED — parked at 0 on purpose.
// com.apple.developer.device-information.user-assigned-device-name also needs an Apple
// entitlement request. Consequence of 0: the device_name sensor and the name shown during
// onboarding fall back to the generic model name ("iPhone") instead of the user's own name
// for the device. Note upstream also forced this to 0 for debug builds.
ENABLE_DEVICE_NAME = 0

// cascades down
PRODUCT_BUNDLE_IDENTIFIER = ${BUNDLE_ID_PREFIX}.$(BRAND_BUNDLE_BASE)${BUNDLE_ID_SUFFIX}${PROVISIONING_SUFFIX}

// resolves some catalyst build-time issues with frameworks and @importing in the objc header we never use
SWIFT_INSTALL_OBJC_HEADER=NO

// works around a realm crash on series 1-3 watches, see https://github.com/home-assistant/iOS/issues/1058
DEAD_CODE_STRIPPING[sdk=watchos*] = NO

// release builds override this
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE_DEFAULT = Automatic

// Create this file to override configuration. It's ignored by git
#include? "HomeAssistant.overrides.xcconfig"

// (The ENABLE_* entitlement flags used to be re-derived here from $(DEVELOPMENT_TEAM).
//  They are now set explicitly above the overrides include — see the block near the top.)

// We mutate the entitlements at build time to support other development teams
CODE_SIGN_ALLOW_ENTITLEMENTS_MODIFICATION = YES
// Mutate certain targets' default signing style because we need manual on ios sdk
CODE_SIGN_STYLE = $(CODE_SIGN_STYLE_DEFAULT)
CODE_SIGN_STYLE[sdk=iphoneos*] = $(CODE_SIGN_STYLE_$(DEVELOPMENT_TEAM)_$(TARGET_NAME:c99extidentifier):default=$CODE_SIGN_STYLE_DEFAULT)
PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*] = $(PROVISIONING_PROFILE_SPECIFIER_$(DEVELOPMENT_TEAM)_$(TARGET_NAME:c99extidentifier))

// Baseline information
SDKROOT = iphoneos
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2,6
IPHONEOS_DEPLOYMENT_TARGET = 15.0
MACOSX_DEPLOYMENT_TARGET = 10.15
WATCHOS_DEPLOYMENT_TARGET = 8.0

CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_OBJC_WEAK = YES
GCC_C_LANGUAGE_STANDARD = gnu11
CLANG_CXX_LANGUAGE_STANDARD = gnu++14
COPY_PHASE_STRIP = NO
// overridden on just the main .app target, since it's the only thing we want in archives
SKIP_INSTALL = YES

// makes the executable more HA-specific so it is in crash logs sorted nicely
PRODUCT_NAME = ApporoAiot-$(TARGET_NAME)
PRODUCT_MODULE_NAME = $(TARGET_NAME:c99extidentifier)

// Catalyst-specific
ENABLE_HARDENED_RUNTIME[sdk=macosx*] = YES

// Warnings/errors
ALWAYS_SEARCH_USER_PATHS = NO
TAPI_VERIFY_MODE = ErrorsAndWarnings
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING = YES
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_BOOL_CONVERSION = YES
CLANG_WARN_CONSTANT_CONVERSION = YES
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
CLANG_WARN_ENUM_CONVERSION = YES
CLANG_WARN_INT_CONVERSION = YES
CLANG_WARN_NON_LITERAL_NULL_CONVERSION = YES
CLANG_WARN_INFINITE_RECURSION = YES
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES
CLANG_WARN_STRICT_PROTOTYPES = YES
CLANG_WARN_COMMA = YES
CLANG_WARN_SUSPICIOUS_IMPLICIT_CONVERSION = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES_AGGRESSIVE
CLANG_WARN_UNREACHABLE_CODE = YES
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VARIABLE = YES
CLANG_WARN_RANGE_LOOP_ANALYSIS = YES
CLANG_WARN_SUSPICIOUS_MOVE = YES
CLANG_WARN_DIRECT_OBJC_ISA_USAGE = YES_ERROR
CLANG_WARN__DUPLICATE_METHOD_MATCH = YES
CLANG_WARN_OBJC_LITERAL_CONVERSION = YES
CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS = YES
GCC_WARN_UNDECLARED_SELECTOR = YES
CLANG_WARN_OBJC_ROOT_CLASS = YES_ERROR
CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF = YES
CLANG_ANALYZER_NONNULL = YES
CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED = YES
GCC_NO_COMMON_BLOCKS = YES

// The upstream "-weak_framework ThreadNetwork" OTHER_LDFLAGS lines were removed together with
// Matter / Thread: nothing in the product links ThreadNetwork any more.
